# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Google Gemini API (for Instagram post classification)
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Instagram Scraper Configuration
INSTAGRAM_TARGET_USERNAME=iu_taiwau
INSTAGRAM_MAX_POSTS=50

# Optional: Instagram Login (to avoid rate limits)
# INSTAGRAM_LOGIN_USERNAME=your_instagram_username
# INSTAGRAM_LOGIN_PASSWORD=your_instagram_password

# Server Configuration
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200

# Database (PostgreSQL)
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/iu_calendar
