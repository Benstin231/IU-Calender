{
  "info": {
    "name": "IU Calendar API",
    "description": "Complete API collection for IU Calendar project - Manage events, Spotify sync, and Instagram sync",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "IU-Calendar"
  },
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/events?limit=100&offset=0",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "events"],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "每頁筆數"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "分頁偏移"
                },
                {
                  "key": "type",
                  "value": "album",
                  "description": "過濾類型 (album/single/concert 等)",
                  "disabled": true
                },
                {
                  "key": "year",
                  "value": "2024",
                  "description": "過濾年份",
                  "disabled": true
                }
              ]
            },
            "description": "取得所有事件，支援分頁和過濾"
          },
          "response": []
        },
        {
          "name": "Get Event by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/events/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "events", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "cmifd1sfa0000u3pooxpui2ky",
                  "description": "事件 ID"
                }
              ]
            },
            "description": "取得單一事件詳細資訊"
          },
          "response": []
        },
        {
          "name": "Get Calendar Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/events/calendar?year=2024&month=11",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "events", "calendar"],
              "query": [
                {
                  "key": "year",
                  "value": "2024",
                  "description": "年份"
                },
                {
                  "key": "month",
                  "value": "11",
                  "description": "月份 (1-12)"
                }
              ]
            },
            "description": "取得特定年月的行事曆事件（分組顯示）"
          },
          "response": []
        }
      ],
      "description": "事件相關 API"
    },
    {
