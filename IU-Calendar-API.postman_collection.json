              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/sync/spotify",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "sync", "spotify"]
            },
            "description": "手動觸發 Spotify 同步，爬取 IU 的專輯資料"
          },
          "response": []
        },
        {
          "name": "Get Sync Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/sync/status",
              "protocol": "http",
              "host": ["localhost"],
