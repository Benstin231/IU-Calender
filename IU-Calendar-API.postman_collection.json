    },
    {
      "name": "Instagram",
      "item": [
        {
          "name": "Trigger Instagram Sync",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"useAI\": true,\n  \"maxPosts\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/instagram/sync",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "instagram", "sync"]
            },
            "description": "手動觸發 Instagram 同步\n\nParameters:\n- useAI: 是否使用 Gemini AI 分類 (true/false)\n- maxPosts: 最多爬取幾篇貼文 (建議 10-50)"
          },
          "response": []
        },
        {
          "name": "Trigger Instagram Sync (Quick - 10 posts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"useAI\": true,\n  \"maxPosts\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/instagram/sync",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "instagram", "sync"]
            },
            "description": "快速同步 - 只抓取 10 篇最新貼文"
          },
          "response": []
        },
        {
          "name": "Trigger Instagram Sync (Without AI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"useAI\": false,\n  \"maxPosts\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/instagram/sync",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "instagram", "sync"]
            },
            "description": "使用關鍵字分類（不使用 AI）"
          },
          "response": []
        },
        {
